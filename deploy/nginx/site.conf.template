# Reverse proxy for the portfolio site. RENDERED AND APPLIED by
# scripts/server-deploy.sh — do not edit the copy in /etc/nginx by hand, it is
# overwritten on every deploy.
#
# Placeholders are wrapped in doubled at-signs and substituted with sed. They
# deliberately do NOT use dollar-brace/envsubst syntax: this file depends on
# nginx runtime variables ($host, $request_uri, $connection_upgrade, …) and
# envsubst would blank every one of them, silently breaking the proxy headers
# and the redirects. A rendered file must contain no doubled at-signs at all.
#
# nginx does NOT terminate TLS here and does not own 443. Xray (3x-ui) holds
# 443/tcp with the site's certificate: it takes the VLESS traffic and passes
# everything else to the loopback ports below over the PROXY protocol, which is
# what makes the site the cover traffic for the tunnel. Two consequences that
# this file depends on:
#
#   - the listeners below MUST keep `proxy_protocol`, and Xray's fallbacks MUST
#     keep `xver: 1`. Change one without the other and every request breaks —
#     nginx would read the PROXY header as an HTTP request line, or lose it.
#   - $scheme is http on these sockets even though the client is on HTTPS, so
#     X-Forwarded-Proto is hardcoded rather than derived.
#
# Ports: 80/tcp (nginx, ACME + redirect) and 443/tcp (Xray). Nothing listens on
# udp. 8080/8081 are loopback-only.

upstream portfolio_web {
    server 127.0.0.1:3000;
    keepalive 16;
}

# --- Shared proxy behaviour -------------------------------------------------
# Nuxt's Nitro server. apps/api/src/app.ts runs with trustProxy: true, so the
# X-Forwarded-* headers below are what the rate limiter sees as the client IP —
# real, not 127.0.0.1, because the PROXY protocol header from Xray carries the
# original address and real_ip_header below adopts it.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

set_real_ip_from 127.0.0.1;
real_ip_header   proxy_protocol;

# --- ACME + plain HTTP ------------------------------------------------------
# The one thing nginx still owns a public port for.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 https://@@SITE_DOMAIN@@$request_uri;
    }
}

# --- Unknown Host: say nothing ----------------------------------------------
# Xray does not reject an unknown SNI, it just serves the site's certificate and
# hands the connection over. This is where such a request dies.
server {
    listen 127.0.0.1:8080 proxy_protocol default_server;
    listen 127.0.0.1:8081 http2 proxy_protocol default_server;
    server_name _;

    return 444;
}

# --- The site ---------------------------------------------------------------
# 8080 serves HTTP/1.1 and 8081 h2c; Xray picks between them by the ALPN it
# negotiated with the client.
server {
    listen 127.0.0.1:8080 proxy_protocol;
    listen 127.0.0.1:8081 http2 proxy_protocol;
    server_name @@SITE_DOMAIN@@;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;

    gzip             on;
    gzip_vary        on;
    gzip_min_length  1024;
    gzip_proxied     any;
    gzip_types       text/plain text/css text/xml application/json application/javascript
                     application/xml+rss image/svg+xml;

    client_max_body_size 1m;

    location / {
        proxy_pass         http://portfolio_web;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        $connection_upgrade;
        proxy_read_timeout 60s;
    }
}

# --- www.<site> -> apex -----------------------------------------------------
server {
    listen 127.0.0.1:8080 proxy_protocol;
    listen 127.0.0.1:8081 http2 proxy_protocol;
    server_name www.@@SITE_DOMAIN@@;

    return 301 https://@@SITE_DOMAIN@@$request_uri;
}
