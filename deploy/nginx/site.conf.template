# Reverse proxy for the portfolio site. RENDERED AND APPLIED by
# scripts/server-deploy.sh — do not edit the copy in /etc/nginx by hand, it is
# overwritten on every deploy.
#
# Placeholders are wrapped in doubled at-signs and substituted with sed. They
# deliberately do NOT use dollar-brace/envsubst syntax: this file depends on
# nginx runtime variables ($host, $request_uri, $connection_upgrade, …) and
# envsubst would blank every one of them, silently breaking the proxy headers
# and the redirects. A rendered file must contain no doubled at-signs at all.
#
# nginx runs on the host rather than in the compose stack because it also owns
# the certificates that the Xray Hysteria2 inbound reads.
#
# Ports: 80 and 443/tcp here; 443/udp belongs to Hysteria2 (3x-ui).

upstream portfolio_web {
    server 127.0.0.1:3000;
    keepalive 16;
}

# --- Shared proxy behaviour -------------------------------------------------
# Nuxt's Nitro server. apps/api/src/app.ts runs with trustProxy: true, so the
# X-Forwarded-* headers below are what the rate limiter sees as the client IP.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# --- ACME + plain HTTP ------------------------------------------------------
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 https://@@SITE_DOMAIN@@$request_uri;
    }
}

# --- Unknown Host on 443: say nothing --------------------------------------
server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name _;

    ssl_certificate     @@CERT_DIR@@/@@SITE_DOMAIN@@/fullchain.pem;
    ssl_certificate_key @@CERT_DIR@@/@@SITE_DOMAIN@@/privkey.pem;

    return 444;
}

# --- The site ---------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name @@SITE_DOMAIN@@;

    ssl_certificate     @@CERT_DIR@@/@@SITE_DOMAIN@@/fullchain.pem;
    ssl_certificate_key @@CERT_DIR@@/@@SITE_DOMAIN@@/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;

    gzip             on;
    gzip_vary        on;
    gzip_min_length  1024;
    gzip_proxied     any;
    gzip_types       text/plain text/css text/xml application/json application/javascript
                     application/xml+rss image/svg+xml;

    client_max_body_size 1m;

    location / {
        proxy_pass         http://portfolio_web;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        $connection_upgrade;
        proxy_read_timeout 60s;
    }
}

# --- www.<site> -> apex -----------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.@@SITE_DOMAIN@@;

    ssl_certificate     @@CERT_DIR@@/@@SITE_DOMAIN@@/fullchain.pem;
    ssl_certificate_key @@CERT_DIR@@/@@SITE_DOMAIN@@/privkey.pem;

    return 301 https://@@SITE_DOMAIN@@$request_uri;
}

# --- Hysteria2 masquerade backend ------------------------------------------
# The 443/udp Hysteria2 inbound proxies anything that is not a valid Hysteria2
# handshake to this listener, so an HTTP/3 probe of the QUIC port gets the very
# same page as a normal browser. Loopback only.
server {
    listen 127.0.0.1:@@MASQUERADE_PORT@@;
    server_name _;

    location / {
        proxy_pass         http://portfolio_web;
        proxy_http_version 1.1;
        proxy_set_header   Host              @@SITE_DOMAIN@@;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        $connection_upgrade;
    }
}
