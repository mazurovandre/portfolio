# One 301-only vhost per entry in REDIRECT_DOMAINS, rendered by
# scripts/server-deploy.sh and appended to the site config. Skipped entirely
# when REDIRECT_DOMAINS is empty.
#
# Each redirect domain still needs its own certificate, because the TLS
# handshake happens before anything can send a 301 — but the certificate is
# loaded by Xray now, not by nginx: it terminates TLS on 443 and forwards the
# decrypted request here over the PROXY protocol. Add the domain to the
# inbound's tlsSettings.certificates or the handshake fails before this vhost is
# ever consulted.
#
# Placeholders are substituted with sed, never envsubst — see the header of
# site.conf.template for why.

server {
    listen 127.0.0.1:8080 proxy_protocol;
    listen 127.0.0.1:8081 http2 proxy_protocol;
    server_name @@REDIRECT_DOMAIN@@ www.@@REDIRECT_DOMAIN@@;

    return 301 https://@@SITE_DOMAIN@@$request_uri;
}
