{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio site: Nuxt (SSR) + Fastify + MongoDB in a single repository",
  "packageManager": "pnpm@8.3.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "seed": "pnpm --filter @portfolio/api seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.10.8",
    "typescript": "^5.9.3"
  }
}
