# ─── MongoDB ────────────────────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=portfolio
MONGO_INITDB_ROOT_PASSWORD=change-me-in-production
MONGO_DB=portfolio
# Local development only (`pnpm docker:up` maps the container port to 27017).
# In compose the api service builds its own URI from the three values above and
# reaches mongo over the internal network, so this line is not used there.
MONGO_URI=mongodb://portfolio:change-me-in-production@localhost:27017/portfolio?authSource=admin

# ─── Fastify API ────────────────────────────────────────────────────────────
# Loopback only for local development. Docker compose substitutes 0.0.0.0,
# otherwise the service would be unreachable from a neighbouring container.
API_HOST=127.0.0.1
API_PORT=4000
# Secret for the private /api/admin/* routes. Generate: openssl rand -hex 32
ADMIN_TOKEN=change-me-openssl-rand-hex-32
# Salt for hashing the IP addresses of form senders (the raw IP is not stored)
IP_HASH_SALT=change-me-openssl-rand-hex-16
# Spam guard on POST /api/messages
RATE_LIMIT_MAX=5
# The quotes are required: the value contains a space, and without them the
# file cannot be loaded with `source .env`.
RATE_LIMIT_WINDOW="10 minutes"
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ─── Nuxt ───────────────────────────────────────────────────────────────────
# Internal API address: Nuxt calls it during SSR and from the server/api proxy.
# The API is not published externally, so in compose this is the service name.
API_INTERNAL_URL=http://localhost:4000
# Public site address — needed for canonical, og:url and sitemap.xml
NUXT_PUBLIC_SITE_URL=http://localhost:3000
